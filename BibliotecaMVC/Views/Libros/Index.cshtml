@model List<Libro>

@{
    ViewData["Title"] = "Libros";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Libros</h2>
    @if (User.IsInRole("Administrador") || User.IsInRole("Bibliotecario"))
    {
        <a asp-action="Create" class="btn btn-success">+ Nuevo libro</a>
    }
</div>

<div class="row">
    @foreach (var libro in Model)
    {
        <div class="col-md-3 mb-4">
            <div class="card h-100">
                <img src="~/images/@libro.ImagenUrl" class="card-img-top" style="height:220px; object-fit:cover;"
                     alt="Portada de @libro.Titulo" onerror="this.src='/images/libro-default.png'" />
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@libro.Titulo</h5>
                    <p class="card-text mb-1"><strong>Autor:</strong> @libro.Autor</p>
                    <p class="card-text mb-1"><strong>Categoría:</strong> @libro.Categoria</p>
                    <p class="card-text mb-2"><strong>Año:</strong> @libro.AnioPublicacion</p>

                    @if (libro.Disponible)
                    {
                        <span class="badge bg-success mb-2 align-self-start">Disponible</span>
                    }
                    else
                    {
                        <span class="badge bg-danger mb-2 align-self-start">No disponible</span>
                    }

                    <div class="mt-auto">
                        <a asp-action="Details" asp-route-id="@libro.Id" class="btn btn-sm btn-info">Ver</a>
                        @if (User.IsInRole("Administrador") || User.IsInRole("Bibliotecario"))
                        {
                            <a asp-action="Edit" asp-route-id="@libro.Id" class="btn btn-sm btn-warning">Editar</a>
                        }
                        @if (User.IsInRole("Administrador"))
                        {
                            <a asp-action="Delete" asp-route-id="@libro.Id" class="btn btn-sm btn-danger">Eliminar</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
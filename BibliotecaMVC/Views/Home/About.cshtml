@{
    ViewData["Title"] = "Acerca de - Biblioteca Virtual";
}

<!-- ============================================
     ACTIVIDAD 5: Hero About
     ============================================ -->
<section class="about-hero">
    <h1><i class="fas fa-info-circle"></i> Acerca de Nosotros</h1>
    <p>Conoce nuestra misión, visión y los servicios que ofrecemos para acercar la lectura a todos</p>
</section>

<!-- ============================================
     ACTIVIDAD 5: Misión y Visión con Flexbox
     ============================================ -->
<section class="mission-vision">
    <div>
        <h2><i class="fas fa-bullseye"></i> Nuestra Misión</h2>
        <p>Democratizar el acceso a la lectura y el conocimiento a través de una plataforma digital accesible, moderna y sencilla de usar, fomentando el hábito de la lectura en todas las edades.</p>
    </div>
    <div>
        <h2><i class="fas fa-eye"></i> Nuestra Visión</h2>
        <p>Ser la biblioteca virtual líder en la región, reconocida por su amplio catálogo, excelente experiencia de usuario y compromiso con la educación y la cultura.</p>
    </div>
</section>

<!-- ============================================
     ACTIVIDAD 4: Componentes Reutilizables - Servicios
     ============================================ -->
<section>
    <h2 class="section-title">📌 Nuestros Servicios</h2>
    <p class="section-subtitle">Conoce todo lo que podemos ofrecerte</p>
    <div class="services-grid">
        <!-- Componente 1: Tarjeta de Servicio -->
        <div class="service-card">
            <div class="icon"><i class="fas fa-book-open"></i></div>
            <h3>Préstamo Digital</h3>
            <p>Accede a miles de libros digitales desde cualquier dispositivo, en cualquier momento.</p>
            <span class="badge">Popular</span>
        </div>

        <!-- Componente 1: Tarjeta de Servicio -->
        <div class="service-card">
            <div class="icon"><i class="fas fa-headphones"></i></div>
            <h3>Audiolibros</h3>
            <p>Disfruta de tus libros favoritos en formato de audio, ideal para aprender mientras te mueves.</p>
            <span class="badge">Nuevo</span>
        </div>

        <!-- Componente 1: Tarjeta de Servicio -->
        <div class="service-card">
            <div class="icon"><i class="fas fa-chalkboard-teacher"></i></div>
            <h3>Clubes de Lectura</h3>
            <p>Únete a comunidades de lectura, comparte opiniones y descubre nuevos títulos recomendados.</p>
            <span class="badge">Gratis</span>
        </div>

        <!-- Componente 1: Tarjeta de Servicio -->
        <div class="service-card">
            <div class="icon"><i class="fas fa-search"></i></div>
            <h3>Búsqueda Avanzada</h3>
            <p>Encuentra exactamente lo que buscas con filtros por autor, género, idioma y más.</p>
            <span class="badge">Premium</span>
        </div>
    </div>
</section>

<!-- ============================================
     ACTIVIDAD 4: Componente 2 - Estadísticas
     ============================================ -->
<section>
    <h2 class="section-title">📊 Estadísticas</h2>
    <p class="section-subtitle">Nuestro impacto en números</p>
    <div class="stats-grid">
        <!-- Componente 2: Tarjeta de Estadística -->
        <div class="stat-card">
            <span class="number">50,000+</span>
            <p class="label">Libros Disponibles</p>
        </div>
        <div class="stat-card">
            <span class="number">10,000+</span>
            <p class="label">Usuarios Activos</p>
        </div>
        <div class="stat-card">
            <span class="number">500+</span>
            <p class="label">Autores Registrados</p>
        </div>
        <div class="stat-card">
            <span class="number">98%</span>
            <p class="label">Satisfacción de Usuarios</p>
        </div>
    </div>
</section>

<section class="team-section">
    <h2 class="section-title">👥 Nuestro Equipo</h2>
    <p class="section-subtitle">Profesionales apasionados por la lectura y la tecnología</p>
    <div class="team-grid">
        <div class="team-member">
            <div class="avatar"><i class="fas fa-user"></i></div>
            <h4>María González</h4>
            <p class="role">Directora de Biblioteca</p>
        </div>
        <div class="team-member">
            <div class="avatar"><i class="fas fa-user"></i></div>
            <h4>Carlos Ramírez</h4>
            <p class="role">Desarrollador Full Stack</p>
        </div>
        <div class="team-member">
            <div class="avatar"><i class="fas fa-user"></i></div>
            <h4>Ana Martínez</h4>
            <p class="role">Curadora de Contenido</p>
        </div>
        <div class="team-member">
            <div class="avatar"><i class="fas fa-user"></i></div>
            <h4>Luis Fernández</h4>
            <p class="role">Diseñador UX/UI</p>
        </div>
    </div>
</section>
@model BibliotecaMVC.Models.LoginViewModel
@{ ViewData["Title"] = "Iniciar sesión"; }
<h2>Iniciar sesión</h2>
<form method="post" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">
 @Html.AntiForgeryToken()
 <div asp-validation-summary="All" class="text-danger"></div>
 <div class="mb-3"><label asp-for="Email"></label><input asp-for="Email" class="form-control" /></div>
 <div class="mb-3"><label asp-for="Password">Contraseña</label><input asp-for="Password" class="form-control" /></div>
 <button class="btn btn-primary" type="submit">Ingresar</button>
</form>

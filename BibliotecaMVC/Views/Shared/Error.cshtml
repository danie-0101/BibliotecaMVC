@model BibliotecaMVC.Models.ErrorViewModel

@{
    ViewData["Title"] = "Ha ocurrido un error";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">

            <div class="mb-4">
                <span class="display-1 text-danger">
                    <i class="bi bi-exclamation-triangle"></i>
                </span>
            </div>

            <h1 class="text-danger mb-3">
                ¡Ups! Algo salió mal
            </h1>

            <p class="lead">
                No pudimos completar tu solicitud.
            </p>

            <p class="text-muted">
                Por favor, intentá nuevamente. Si el problema continúa,
                comunicate con el administrador de la biblioteca.
            </p>

            @if (Model?.ShowRequestId == true)
            {
                <p class="small text-muted mt-3">
                    Código de seguimiento:
                    <code>@Model.RequestId</code>
                </p>
            }

            <div class="mt-4">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-primary me-2">
                    Volver al inicio
                </a>

                <a asp-controller="Libros"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Ir a libros
                </a>
            </div>

        </div>
    </div>
</div>


<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Biblioteca Virtual
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/home.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/about.css"
          asp-append-version="true" />
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">

            <a class="navbar-brand"
               asp-controller="Home"
               asp-action="Index">

                <i class="fas fa-book-open"></i>
                Biblioteca Virtual
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navMenu"
                    aria-controls="navMenu"
                    aria-expanded="false"
                    aria-label="Abrir menú">

                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse"
                 id="navMenu">

                <ul class="navbar-nav ms-auto">

                    <!-- INICIO -->
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">
                            <i class="fas fa-home"></i>
                            Inicio
                        </a>
                    </li>

                    <!-- CATEGORÍAS -->
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Categorias"
                           asp-action="Index">
                            <i class="fas fa-tags"></i>
                            Categorías
                        </a>
                    </li>

                    <!-- LIBROS -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Libros"
                               asp-action="Index">
                                <i class="fas fa-book"></i>
                                Libros
                            </a>
                        </li>
                    }

                    <!-- AUTORES -->
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Autores"
                           asp-action="Index">
                            <i class="fas fa-user-edit"></i>
                            Autores
                        </a>
                    </li>

                    <!-- ADMINISTRACIÓN DE ROLES -->
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Roles"
                               asp-action="Index">
                                <i class="fas fa-users-cog"></i>
                                Roles
                            </a>
                        </li>
                    }

                    <!-- USUARIO AUTENTICADO -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-light">
                                @User.Identity.Name

                                (
                                @(User.IsInRole("Admin")
                                    ? "Admin"
                                    : User.IsInRole("Bibliotecario")
                                        ? "Bibliotecario"
                                        : User.IsInRole("Usuario")
                                            ? "Usuario"
                                            : "Sin rol")
                                )
                            </span>
                        </li>

                        <!-- CERRAR SESIÓN -->
                        <li class="nav-item">
                            <form asp-controller="Cuenta"
                                  asp-action="Logout"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-outline-light btn-sm mt-1">
                                    Cerrar sesión
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <!-- INICIAR SESIÓN -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Cuenta"
                               asp-action="Login">
                                Iniciar sesión
                            </a>
                        </li>

                        <!-- REGISTRARSE -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Cuenta"
                               asp-action="Registro">
                                Registrarse
                            </a>
                        </li>
                    }

                </ul>
            </div>
        </div>
    </nav>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="container mt-4">
        @RenderBody()
    </main>

    <!-- PIE DE PÁGINA -->
    <footer class="bg-dark text-white text-center py-3 mt-5">
        <div class="container">

            <p class="mb-1">
                <i class="fas fa-copyright"></i>
                2024 Biblioteca Virtual
            </p>

            <div class="mb-2">

                <a href="#"
                   class="btn btn-primary btn-sm"
                   aria-label="Facebook">
                    <i class="fab fa-facebook"></i>
                </a>

                <a href="#"
                   class="btn btn-info btn-sm"
                   aria-label="Twitter">
                    <i class="fab fa-twitter"></i>
                </a>

                <a href="#"
                   class="btn btn-danger btn-sm"
                   aria-label="Instagram">
                    <i class="fab fa-instagram"></i>
                </a>

                <a href="#"
                   class="btn btn-danger btn-sm"
                   aria-label="YouTube">
                    <i class="fab fa-youtube"></i>
                </a>

            </div>

            <p class="mb-0">
                <i class="fas fa-envelope"></i>
                contacto@biblioteca.com
            </p>

        </div>
    </footer>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

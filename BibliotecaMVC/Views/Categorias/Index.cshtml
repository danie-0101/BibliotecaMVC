@model List<Categoria>

@{
    ViewData["Title"] = "Categorías";
}

<h2>Categorías</h2>

@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @ViewBag.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (User.IsInRole("Administrador")) { <a asp-action="Create" class="btn btn-primary mb-3">Agregar Nueva Categoría</a> }

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No hay categorías registradas. @if (User.IsInRole("Administrador")) { <a asp-action="Create">Agregue una nueva categoría</a> }
    </div>
}
else
{
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Descripción</th>
                @if (User.IsInRole("Administrador")) { <th>Acciones</th> }
            </tr>
        </thead>
        <tbody>
            @foreach (var categoria in Model)
            {
                <tr>
                    <td>
                        <strong>@categoria.Nombre</strong>
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(categoria.Descripcion))
                        {
                            @categoria.Descripcion
                        }
                        else
                        {
                            <em class="text-muted">Sin descripción</em>
                        }
                    </td>
                    @if (User.IsInRole("Administrador")) {
                    <td>
                        <a asp-action="Edit" asp-route-id="@categoria.Id" class="btn btn-sm btn-warning" title="Editar categoría">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                        <a asp-action="Delete" asp-route-id="@categoria.Id" class="btn btn-sm btn-danger" title="Eliminar categoría">
                            <i class="bi bi-trash"></i> Eliminar
                        </a>
                    </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
